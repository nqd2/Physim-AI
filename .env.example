# Server only. Do not use an EXPO_PUBLIC_ prefix for the OpenAI key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
PORT=4000
HOST=0.0.0.0
# Include the actual Expo Web development origin when using a phone over LAN.
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:4000,http://127.0.0.1:4000
# Optional absolute paths; omit to use project-local storage and the Expo export.
# PHET_STORAGE_DIR=
# WEB_DIST_DIR=
# PHYSIM_WORKSPACE_ROOT=
