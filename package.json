{
  "name": "physim-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Phòng thí nghiệm Vật lý THPT với PhET, Expo và Express",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @physim/server --filter @physim/mobile dev",
    "dev:server": "pnpm --filter @physim/server dev",
    "dev:mobile": "pnpm --filter @physim/mobile dev",
    "start": "pnpm --filter @physim/server start",
    "check": "pnpm -r check",
    "test": "pnpm -r test && node --test tests/phet-pipeline*.test.mjs tests/bridge*.test.mjs",
    "build": "pnpm --filter @physim/shared build && pnpm --filter @physim/server build && pnpm --filter @physim/mobile build",
    "phet:sync": "node scripts/phet-pipeline.mjs",
    "legacy:start": "node server.js",
    "legacy:test": "node --test tests/server.test.js",
    "phet:verify": "node scripts/verify-phet-browser.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "playwright-core": "1.65.1"
  }
}
