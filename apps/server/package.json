{
  "name": "@physim/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "start": "node --env-file-if-exists=.env dist/server.mjs",
    "check": "tsc -p tsconfig.json",
    "build": "esbuild src/index.ts --bundle --external:express --external:cors --external:openai --external:zod --format=esm --target=node24 --platform=node --outfile=dist/server.mjs"
  },
  "dependencies": {
    "@physim/shared": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "openai": "^7.57.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "esbuild": "^0.27.0"
  }
}
